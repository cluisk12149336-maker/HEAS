# Supabase Database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email Option 1: Google Apps Script Webhook (Recommended for Render Free Tier - HTTPS port 443, no SMTP port blocks)
EMAIL_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec

# Email Option 2: Brevo API Key (HTTPS port 443 - 300 free emails/day)
# BREVO_API_KEY=xkeysib-your-brevo-api-key

# Email Option 3: Resend API Key (HTTPS port 443)
# RESEND_API_KEY=re_your-resend-api-key

# Email Option 4: Traditional SMTP (Works locally or on non-blocking hosts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sender-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-sender-email@gmail.com

# Google OAuth 2.0 (Optional)
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_CALLBACK_URL_PROD=https://your-app-name.onrender.com/api/auth/google/callback